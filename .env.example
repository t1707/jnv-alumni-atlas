# Copy to .env (local dev) or set these in your host's dashboard.
# All are server-side only — do NOT prefix any of them with VITE_, or the value
# gets inlined into the client bundle and shipped to every visitor.

# Full service-account JSON key, as a single line.
# Generate the value from the downloaded key file with:
#   jq -c . ~/jnv-alumni-atlas-key.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"jnv-alumni-atlas@ref-connect.iam.gserviceaccount.com",...}

# From the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
ALUMNI_SHEET_ID=1PYGfXLP1VdTUX6B_sGTANGK_pvl8h9PA1TyEamgOwUE

# Tab NAME, not the gid. Optional — defaults to Sheet1, and any all-numeric
# value is ignored (see the guard in src/lib/alumni.functions.ts).
ALUMNI_SHEET_TAB=Sheet1

# Gates the admin listing, which returns mobile numbers and emails.
ADMIN_PASSWORD=change-me
